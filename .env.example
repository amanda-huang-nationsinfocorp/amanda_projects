# Copy this file to .env (same folder) and fill in the values. .env is gitignored.
# Every script and notebook in this repo loads it automatically via python-dotenv.

SNOWFLAKE_ACCOUNT=your-org-your-account

# Service account + programmatic access token (Snowflake > user > Programmatic access tokens)
SNOWFLAKE_USER=your-service-account-user
SNOWFLAKE_TOKEN=your-programmatic-access-token
